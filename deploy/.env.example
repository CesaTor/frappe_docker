# Frappe deploy environment template.
# Copy to .env and fill in real values:  cp .env.example .env
# Reference: docs/02-setup/04-env-variables.md

# --- Custom image (built from deploy/apps.json via images/layered/Containerfile) ---
CUSTOM_IMAGE=frappe-requrv
CUSTOM_TAG=16
PULL_POLICY=missing

# --- Versions (informational; the image is built from apps.json) ---
ERPNEXT_VERSION=v16.34.1

# --- Database (containerized MariaDB) ---
# CHANGE to a strong password.
# Quote it so special characters (!, &, $, etc.) are safe for both Docker Compose and bash.
DB_PASSWORD="changeit"

# --- Backend tuning (defaults are fine to start) ---
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# --- Site admin password (used by setup.sh for all sites) ---
# CHANGE to a strong password. Quote it (see DB_PASSWORD note).
ADMIN_PASSWORD="changeit"

# --- Deployment target ---
# dev   -> builds for the host arch, uses the arm64 override on Apple Silicon,
#          creates *.localhost sites (no proxy).
# prod  -> builds for linux/amd64, omits the arm64 override, and creates the
#          real subdomain sites (erp/crm/helpdesk.<DOMAIN>).
ENVIRONMENT=dev

# Host port for the frontend (default 8060). Change if 8060 is occupied — e.g. 8061 / 18080.
# Compose uses ${HTTP_PUBLISH_PORT:-8060}:8060; Caddyfile reverse_proxy must match this value.
HTTP_PUBLISH_PORT=8060

# Only used when ENVIRONMENT=prod: the base domain for the three sites.
DOMAIN=requrv.io
